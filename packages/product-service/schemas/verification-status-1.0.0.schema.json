{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentbench.local/schemas/verification-status-1.0.0.schema.json",
  "title": "IntentBench verification status response",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "snapshotId", "status", "outcome", "revision", "createdAt", "updatedAt"],
  "properties": {
    "runId": { "$ref": "#/$defs/identifier" },
    "snapshotId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": {
      "enum": ["PENDING", "REVIEWING", "CALIBRATING", "SUCCEEDED", "FAILED", "CANCELLED"]
    },
    "outcome": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETE",
        "INCOMPLETE",
        "UNKNOWN",
        "INFRASTRUCTURE_FAILURE",
        "CANCELLED"
      ]
    },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "reportId": { "$ref": "#/$defs/identifier" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] },
      "then": {
        "properties": { "verdict": true, "reportId": true },
        "required": ["verdict", "reportId"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": { "properties": { "error": true }, "required": ["error"] }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["INPUT", "SECURITY", "STATE", "REVIEW", "INFRASTRUCTURE", "INTERNAL"]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
