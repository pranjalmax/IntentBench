{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentbench.local/schemas/verification-activity-1.0.0.schema.json",
  "title": "IntentBench sanitized verification activity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sequence", "occurredAt", "source", "kind", "message"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": { "enum": ["SYSTEM", "EXECUTOR", "MODEL", "GATE"] },
    "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
