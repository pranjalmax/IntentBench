{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentbench.local/schemas/candidate-snapshot-1.0.0.schema.json",
  "title": "IntentBench candidate snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "contentHash",
    "createdAt",
    "specPath",
    "fileCount",
    "totalBytes",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "snapshotId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contentHash": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "specPath": { "type": "string", "minLength": 1 },
    "fileCount": { "type": "integer", "minimum": 1 },
    "totalBytes": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "size", "sha256"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
