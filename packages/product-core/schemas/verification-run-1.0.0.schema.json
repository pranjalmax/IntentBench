{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentbench.local/schemas/verification-run-1.0.0.schema.json",
  "title": "IntentBench durable verification run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "snapshotId",
    "verifierProfileId",
    "status",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/identifier" },
    "snapshotId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "verifierProfileId": { "const": "a1.1-frozen" },
    "status": {
      "enum": ["PENDING", "REVIEWING", "CALIBRATING", "SUCCEEDED", "FAILED", "CANCELLED"]
    },
    "revision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "reportId": { "$ref": "#/$defs/identifier" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] },
      "then": {
        "required": ["verdict", "reportId"],
        "properties": { "verdict": true, "reportId": true, "error": false }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "required": ["error"],
        "properties": { "verdict": false, "reportId": false, "error": true }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["PENDING", "REVIEWING", "CALIBRATING", "CANCELLED"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": { "verdict": false, "reportId": false, "error": false }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "ARCHIVE_INVALID",
            "ARCHIVE_LIMIT_EXCEEDED",
            "ARCHIVE_PATH_UNSAFE",
            "ARCHIVE_ENTRY_UNSUPPORTED",
            "ARCHIVE_SENSITIVE_CONTENT",
            "SPEC_MISSING",
            "SNAPSHOT_INTEGRITY",
            "RUN_NOT_FOUND",
            "RUN_CONFLICT",
            "RUN_INVALID_TRANSITION",
            "RUN_STORE_CORRUPT",
            "REVIEW_OUTPUT_INVALID",
            "REVIEW_EVIDENCE_INCOMPLETE",
            "EXECUTOR_UNAVAILABLE",
            "EXECUTION_FORBIDDEN",
            "INTERNAL_ERROR"
          ]
        },
        "category": {
          "enum": ["INPUT", "SECURITY", "STATE", "REVIEW", "INFRASTRUCTURE", "INTERNAL"]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
